<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca de doit: un anillo a medio completar que termina en un check.
    Cuenta lo que hace la app: en curso -> hecho.

    Va dentro del cuadrado oscuro (bg_boton_primario) de la pantalla de login,
    por eso el check es blanco. Sin android:tint a proposito: el anillo tiene
    que conservar el morado de acento de la paleta.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Anillo abierto: arranca arriba y gira 300 grados -->
    <path
        android:pathData="M60,14 A46,46 0 1 1 20.2,37"
        android:strokeColor="@color/acento"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Check, holgado dentro del anillo para que no lo roce -->
    <path
        android:pathData="M40,61 L54,75 L80,45"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
