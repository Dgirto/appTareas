<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="22dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circulo_peligro"
        android:contentDescription="@string/desc_eliminar"
        android:padding="17dp"
        android:src="@drawable/ic_eliminar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/eliminar_titulo"
        android:textColor="@color/tinta"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/gris_texto"
        android:textSize="15sp"
        tools:text="«Revisar documentos» se eliminará de forma permanente." />

    <TextView
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_boton_peligro"
        android:gravity="center"
        android:text="@string/eliminar_confirmar"
        android:textColor="@color/blanco"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_boton_secundario"
        android:gravity="center"
        android:text="@string/cancelar"
        android:textColor="@color/primario"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>